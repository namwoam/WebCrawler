{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "crawler-poc-prometheus",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRole",
      "metadata": {
        "name": "crawler-poc-prometheus",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        }
      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "nodes",
            "nodes/proxy",
            "pods",
            "services",
            "endpoints"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        },
        {
          "nonResourceURLs": [
            "/metrics"
          ],
          "verbs": [
            "get"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "crawler-poc-prometheus",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        }
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "crawler-poc-prometheus"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "crawler-poc-prometheus",
          "namespace": "crawler-poc"
        }
      ]
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "crawler-poc-prometheus",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      },
      "data": {
        "prometheus.yml": "global:\n  scrape_interval: 15s\n  evaluation_interval: 15s\nscrape_configs:\n  - job_name: prometheus\n    static_configs:\n      - targets: ['localhost:9090']\n  - job_name: kube-state-metrics\n    static_configs:\n      - targets: ['crawler-poc-state-metrics:8080']\n  - job_name: kubernetes-cadvisor\n    scheme: https\n    bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token\n    tls_config:\n      ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt\n    kubernetes_sd_configs:\n      - role: node\n    relabel_configs:\n      - target_label: __address__\n        replacement: kubernetes.default.svc:443\n      - source_labels: [__meta_kubernetes_node_name]\n        target_label: node\n      - source_labels: [__meta_kubernetes_node_name]\n        target_label: __metrics_path__\n        replacement: /api/v1/nodes/$1/proxy/metrics/cadvisor\n  - job_name: kubernetes-kubelet\n    scheme: https\n    bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token\n    tls_config:\n      ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt\n    kubernetes_sd_configs:\n      - role: node\n    relabel_configs:\n      - target_label: __address__\n        replacement: kubernetes.default.svc:443\n      - source_labels: [__meta_kubernetes_node_name]\n        target_label: node\n      - source_labels: [__meta_kubernetes_node_name]\n        target_label: __metrics_path__\n        replacement: /api/v1/nodes/$1/proxy/metrics\n  - job_name: crawler-poc\n    kubernetes_sd_configs:\n      - role: pod\n        namespaces:\n          names: [crawler-poc]\n    relabel_configs:\n      - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]\n        action: keep\n        regex: 'true'\n      - source_labels: [__meta_kubernetes_pod_container_port_name]\n        action: keep\n        regex: metrics\n      - source_labels: [__meta_kubernetes_pod_node_name]\n        target_label: node\n      - source_labels: [__meta_kubernetes_pod_name]\n        target_label: pod\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "crawler-poc-prometheus",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "crawler-poc-prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "crawler-poc-prometheus"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "prometheus",
                "image": "prom/prometheus:v3.15.1",
                "args": [
                  "--config.file=/etc/prometheus/prometheus.yml",
                  "--storage.tsdb.path=/prometheus",
                  "--storage.tsdb.retention.time=24h",
                  "--storage.tsdb.retention.size=2GB",
                  "--web.external-url=http://172.16.191.1:18090/prometheus",
                  "--web.route-prefix=/"
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 9090
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/prometheus"
                  },
                  {
                    "name": "data",
                    "mountPath": "/prometheus"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090
                  },
                  "initialDelaySeconds": 3
                }
              }
            ],
            "serviceAccountName": "crawler-poc-prometheus",
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "crawler-poc-prometheus"
                }
              },
              {
                "name": "data",
                "emptyDir": {
                  "sizeLimit": "3Gi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "crawler-poc-prometheus",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      },
      "spec": {
        "selector": {
          "app": "crawler-poc-prometheus"
        },
        "ports": [
          {
            "name": "http",
            "port": 9090,
            "targetPort": 9090
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "crawler-poc-state-metrics",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRole",
      "metadata": {
        "name": "crawler-poc-state-metrics",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        }
      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "nodes",
            "pods",
            "persistentvolumes",
            "persistentvolumeclaims"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        },
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments",
            "replicasets",
            "statefulsets"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "crawler-poc-state-metrics",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        }
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "crawler-poc-state-metrics"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "crawler-poc-state-metrics",
          "namespace": "crawler-poc"
        }
      ]
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "crawler-poc-state-metrics",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "crawler-poc-state-metrics"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "crawler-poc-state-metrics"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "state-metrics",
                "image": "registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.20.0",
                "args": [
                  "--namespaces=crawler-poc,kube-system",
                  "--resources=nodes,pods,persistentvolumes,persistentvolumeclaims,deployments,statefulsets"
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  }
                }
              }
            ],
            "serviceAccountName": "crawler-poc-state-metrics"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "crawler-poc-state-metrics",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      },
      "spec": {
        "selector": {
          "app": "crawler-poc-state-metrics"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "crawler-poc-gateway",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      },
      "data": {
        "nginx.conf": "events { worker_connections 4096; }\nhttp {\n  access_log off;\n  resolver 10.243.0.10 valid=10s;\n  server {\n    listen 8080;\n    client_max_body_size 300m;\n    location = /gateway-healthz { return 200 'ok'; }\n    location ^~ /_worker/ { return 404; }\n    location = /prometheus { return 301 /prometheus/; }\n    location /prometheus/ {\n      set $prometheus_backend http://crawler-poc-prometheus.crawler-poc.svc.cluster.local:9090;\n      rewrite ^/prometheus/(.*)$ /$1 break;\n      proxy_pass $prometheus_backend;\n      proxy_read_timeout 60s;\n    }\n    location / {\n      set $api_backend http://crawler-api.crawler-poc.svc.cluster.local:8080;\n      proxy_pass $api_backend;\n      proxy_read_timeout 180s;\n    }\n  }\n}\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "crawler-poc-gateway",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "crawler-poc-gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "crawler-poc-gateway"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "gateway",
                "image": "nginx:stable-alpine",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "128Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/nginx.conf",
                    "subPath": "nginx.conf"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/gateway-healthz",
                    "port": 8080
                  }
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "crawler-poc-gateway"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "crawler-poc-gateway",
        "labels": {
          "app.kubernetes.io/part-of": "crawler-poc"
        },
        "namespace": "crawler-poc"
      },
      "spec": {
        "selector": {
          "app": "crawler-poc-gateway"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080,
            "nodePort": 30080
          }
        ],
        "type": "NodePort"
      }
    }
  ]
}