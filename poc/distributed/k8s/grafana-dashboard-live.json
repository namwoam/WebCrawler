        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (worker_id) (rate({service=\"crawler-poc\", worker_id=~\"$worker_id\", event=\"request.start\"}[1m]))",
          "legendFormat": "crawler_{{worker_id}}",
          "refId": "A"
        }
      ],
      "title": "QPS per crawler worker",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": {
            "filterable": true,
