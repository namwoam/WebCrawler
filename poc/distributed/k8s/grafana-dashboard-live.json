        "sortBy": [
          {
            "displayName": "QPS",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "enablePagination": true,
          "reducer": []
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{domain}}",
          "expr": "sum by(domain)(count_over_time({service=\"crawler-poc\",worker_id=~\"$worker_id\",event=\"request.start\"} | json domain=\"domain\" | __error__=\"\" | keep domain [5s])) / 5"
        }
      ],
      "title": "QPS per domain (all active domains, last 5s)",
      "type": "table",
      "description": "One row per domain with HTTP starts in the last five seconds, averaged per second. Includes robots, retries and redirects. Use the Domain column filter to find a host. Inactive domains are absent from this live snapshot; this is not a full benchmark history.",
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Metric": "Domain",
              "Value": "QPS"
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
