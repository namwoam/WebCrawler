        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum(rate({service=\"crawler-poc\",worker_id=~\"$worker_id\",event=\"request.end\"} | json | status < 400 [5m])) or vector(0)) / ((sum(rate({service=\"crawler-poc\",worker_id=~\"$worker_id\",event=\"request.end\"}[5m])) or vector(0)) + (sum(rate({service=\"crawler-poc\",worker_id=~\"$worker_id\",event=\"request.fail\"} | json | fail_reason !~ \"HttpError.*\" [5m])) or vector(0)))",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ],
      "title": "Success rate (last 5m)",
      "type": "stat",
      "description": "HTTP attempts with status below 400 divided by all completed HTTP attempts, including network failures. Includes robots, redirects and retries; differs from final successful HTML per submitted URL."
    },
