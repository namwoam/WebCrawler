      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(crawler_urls_completed_total{outcome=\"error\"}[2m])) / clamp_min(sum(rate(crawler_urls_completed_total[2m])), 0.000001) or vector(0)",
          "legendFormat": "URL error %",
          "datasource": {
            "type": "prometheus",
            "uid": "crawler-poc-prometheus"
          }
        }
      ]
    },
