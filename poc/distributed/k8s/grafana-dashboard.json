{
  "uid": "crawler-poc",
  "title": "Crawler POC \u2014 Distributed",
  "tags": [
    "crawler-poc",
    "kubernetes"
  ],
  "description": "Three physical nodes, max 40 CPU each. Worker benchmarks: 10/25/50/75/100, baseline 50. Crawler metrics become available as application workers are deployed. Node CPU charts include POC namespace pods, excluding control-plane system processes.",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Ready nodes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "crawler-poc-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "Ready nodes",
          "datasource": {
            "type": "prometheus",
            "uid": "crawler-poc-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Running crawler workers",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "crawler-poc-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{namespace=\"crawler-poc\",pod=~\"crawler-worker-.*\",phase=\"Running\"}) or vector(0)",
          "legendFormat": "Running crawler workers",
          "datasource": {
            "type": "prometheus",
            "uid": "crawler-poc-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP requests / sec",
