      "targets": [
        {
          "refId": "A",
          "expr": "sum by(node) (rate(container_cpu_usage_seconds_total{namespace=\"crawler-poc\",container!=\"\",container!=\"POD\"}[2m]))",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "crawler-poc-prometheus"
