      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(crawler_http_requests_total[1m])) or vector(0)",
          "legendFormat": "HTTP requests / sec",
          "datasource": {
            "type": "prometheus",
            "uid": "crawler-poc-prometheus"
          }
        }
      ]
    },
