{"apiVersion":"apps/v1","kind":"DaemonSet","metadata":{"name":"crawler-poc-network-offload","namespace":"kube-system"},"spec":{"selector":{"matchLabels":{"app":"crawler-poc-network-offload"}},"template":{"metadata":{"labels":{"app":"crawler-poc-network-offload"}},"spec":{"hostNetwork":true,"tolerations":[{"operator":"Exists"}],"containers":[{"name":"offload","image":"rancher/k3s:v1.37.1-k3s1","command":["/bin/sh","-c","while true; do /bin/ethtool -K eth0 tx-checksum-ip-generic off; if /bin/ip link show flannel.1 >/dev/null 2>&1; then /bin/ethtool -K flannel.1 tx-checksum-ip-generic off; fi; sleep 30; done"],"securityContext":{"privileged":true},"resources":{"requests":{"cpu":"5m","memory":"8Mi"},"limits":{"cpu":"100m","memory":"32Mi"}}}]}}}}
